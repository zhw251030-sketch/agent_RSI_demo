    },
    {
      "rule_id": "R02",
      "instruction": "Prioritize the earliest failure actually observed during execution; do not equate proposed plan length with executed actions."
    },
    {
      "rule_id": "R03",
      "instruction": "Preserve the explicit task rules and constraints; do not rewrite the environment definition to repair an artifact."
    },
    {
      "rule_id": "R04",
      "instruction": "Use the exact metric, units, sign, candidate identity, and data scope; do not substitute one statistic for another."
    },
    {
      "rule_id": "R05",
      "instruction": "Connect a diagnostic observation to the source location to change and the failure expected to disappear; verify that the submitted source includes that change."
    },
    {
      "rule_id": "R06",
      "instruction": "Treat marginal associations as hypotheses, consider alternative explanations, and do not declare an associated structure necessary."
    },
    {
      "rule_id": "R07",
      "instruction": "Compare previous forecasts with observed changes and choose an absolute improvement threshold proportionate to the evidence."
    },
    {
      "rule_id": "R08",
      "instruction": "Preserve correct behavior while making a complete valid repair, and avoid unrelated complexity."
    }
